{
  "name": "teleprompter",
  "productName": "Teleprompter",
  "version": "1.0.0",
  "description": "Teleprompter que se controla desde el teléfono por Wi-Fi, sin internet.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "servidor": "node servidor.js",
    "test": "node --test pruebas/*.test.js",
    "empaquetar": "electron-builder --mac --arm64 --dir"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.inmueblesaudiovisuales.teleprompter",
    "productName": "Teleprompter",
    "files": ["main.js", "servidor.js", "pantalla.html", "package.json"],
    "mac": {
      "category": "public.app-category.video",
      "target": "dir",
      "identity": null,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "El teleprompter usa la red local para que el teléfono lo controle."
      }
    }
  }
}
